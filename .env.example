# Server
PORT=3001
NODE_ENV=development

# Admin session signing (required)
SESSION_SECRET=change-this-to-a-long-random-secret
ADMIN_SESSION_TTL_SECONDS=28800

# Supabase Auth (required for admin login)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Exactly two allowed admin users (required)
ADMIN_OWNER_EMAIL=kuothassan5@gmail.com
ADMIN_EDITOR_EMAIL=kiir1888@gmail.com

# CORS (optional, comma-separated origins)
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Optional SMTP for contact email notifications
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASS=your-password
# CONTACT_EMAIL=inbox@yourdomain.com
